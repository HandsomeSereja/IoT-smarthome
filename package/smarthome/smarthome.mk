SMARTHOME_VERSION = 1.0
SMARTHOME_SITE = $(BR2_EXTERNAL_SMARTHOME_PATH)/package/smarthome/src
SMARTHOME_SITE_METHOD = local
SMARTHOME_INSTALL_STAGING = NO
SMARTHOME_INSTALL_TARGET = YES

define SMARTHOME_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) $(TARGET_CONFIGURE_OPTS) -C $(@D)
endef

define SMARTHOME_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/smarthome $(TARGET_DIR)/usr/bin/smarthome
endef

$(eval $(generic-package))
